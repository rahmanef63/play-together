# Complete Play Together environment contract: project-set, tooling, and platform-injected values.
# Replace project-owned <placeholders>; entries marked provided-by-platform are informational.
# Never commit real secrets.

# Local ports & Compose
# Project-owned Compose namespace.
COMPOSE_PROJECT_NAME=play-together
# Host interface for local published ports.
BIND_ADDRESS=127.0.0.1
# Local web port.
WEB_PORT=4173
# Local realtime port.
REALTIME_PORT=8787
# Local immutable game CDN port.
GAME_CDN_PORT=8081
# Local self-hosted Convex API port.
CONVEX_PORT=43210
# Local self-hosted Convex site port.
CONVEX_SITE_PORT=43211
# Local Convex dashboard port.
CONVEX_DASHBOARD_PORT=46791

# Public endpoints
# Browser-visible Convex deployment URL.
VITE_CONVEX_URL=<https://deployment.convex.cloud>
# Browser-visible realtime URL. Production may leave this unset to use same-origin /api/realtime.
VITE_REALTIME_URL=<optional-wss://host/api/realtime>
# Public immutable game asset origin.
GAME_CDN_PUBLIC_ORIGIN=https://game.rahmanef.com
# Exact browser origins accepted by realtime.
ALLOWED_ORIGINS=https://game.rahmanef.com
# Exact origins allowed for game module loading.
GAME_MODULE_ORIGINS=https://game.rahmanef.com
# Optional public-to-private module fetch routing map.
GAME_MODULE_FETCH_ORIGIN_MAP={}
# Allows HTTP game origins only for local development.
ALLOW_INSECURE_GAME_ORIGINS=false

# Shared security
# Shared by Convex ticket issuance and realtime verification.
JOIN_TICKET_SECRET=<generate-48-byte-base64url>
# Authorizes immutable game publication.
GAME_PUBLISH_TOKEN=<generate-32-byte-base64url>
# Signs private template download tickets.
TEMPLATE_DOWNLOAD_SECRET=<generate-at-least-32-bytes>
# Authorizes template publication.
TEMPLATE_PUBLISH_TOKEN=<generate-random-token>
# Validates template purchase webhooks.
TEMPLATE_SALES_WEBHOOK_SECRET=<checkout-webhook-hmac-secret>
# Optional server CSP override; omit to use the hardened default.
CONTENT_SECURITY_POLICY=<optional-custom-csp>

# Self-hosted Convex
# Admin/deploy URL for the local self-hosted Convex backend.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:43210
# Generated local Convex admin key; normally managed under .local/.
CONVEX_SELF_HOSTED_ADMIN_KEY=<generated-by-pnpm-stack:bootstrap>
# Self-hosted Convex instance name.
CONVEX_INSTANCE_NAME=play-together-local
# Self-hosted Convex instance secret; pnpm env:local generates it.
CONVEX_INSTANCE_SECRET=<generate-32-byte-hex>
# Public API origin advertised by local Convex.
CONVEX_CLOUD_ORIGIN=http://convex.localhost:43210
# Public site/auth origin advertised by local Convex.
CONVEX_SITE_ORIGIN=http://convex-site.localhost:43211
# Redacts self-hosted Convex logs sent to clients.
REDACT_LOGS_TO_CLIENT=true
# Controls local Convex metrics endpoint.
DISABLE_METRICS_ENDPOINT=false
# Disables self-hosted Convex telemetry beacon.
DISABLE_BEACON=true
# Self-hosted Convex document retention delay.
DOCUMENT_RETENTION_DELAY=172800
# Development loopback proxy upstream override.
UPSTREAM_ORIGIN=http://127.0.0.1:3211

# Convex Cloud & Auth
# Server/release tooling Convex deployment URL.
CONVEX_URL=<https://deployment.convex.cloud>
# Convex Auth issuer/site URL; typically provided by Convex runtime.
CONVEX_SITE_URL=<https://deployment.convex.site>
# Canonical application URL used by Convex Auth.
SITE_URL=https://game.rahmanef.com
# Convex Auth signing private key.
JWT_PRIVATE_KEY=<convex-auth-private-key>
# Convex Auth JSON Web Key Set matching JWT_PRIVATE_KEY.
JWKS=<convex-auth-jwks-json>
# Google OAuth Web client ID.
AUTH_GOOGLE_ID=<google-oauth-web-client-id>
# Google OAuth Web client secret.
AUTH_GOOGLE_SECRET=<google-oauth-web-client-secret>
# CI key used to deploy Convex production.
CONVEX_DEPLOY_KEY=<convex-production-deploy-key>

# Transactional email
# Server-only Resend API key.
RESEND_API_KEY=<resend-server-api-key>
# Verified transactional sender address.
EMAIL_FROM_ADDRESS=official@rahmanef.com
# Brand name rendered in transactional email.
EMAIL_PROJECT_NAME=Play Together
# Stable project tag sent to the email provider.
EMAIL_PROJECT_TAG=play-together
# Optional reply-to mailbox.
EMAIL_REPLY_TO=<optional-reply-to-address>
# Canonical site link used in email header/footer.
EMAIL_SITE_URL=https://game.rahmanef.com

# Managed production runtime
# Cross-function room coordination and release-control Redis connection.
REDIS_URL=<vercel-redis-connection-url>
# Private template package Blob credential.
BLOB_READ_WRITE_TOKEN=<vercel-private-blob-token>
# Fails production realtime startup when distributed coordination is unavailable.
REQUIRE_DISTRIBUTED_COORDINATION=true
# Requires release-control mirror reconciliation during managed publication.
RELEASE_CONTROL_REQUIRED=true
# Realtime compatibility override; keep false outside explicit non-browser testing.
ALLOW_MISSING_ORIGIN=false
# Room worker idle timeout.
ROOM_IDLE_TIMEOUT_MS=30000
# Maximum realtime payload size.
MAX_PAYLOAD_BYTES=65536
# Vercel runtime marker used to enforce managed coordination behavior.
VERCEL=<provided-by-vercel>
# Current Vercel deployment hostname used for exact origin admission.
VERCEL_URL=<provided-by-vercel>
# Canonical Vercel production hostname used for origin admission.
VERCEL_PROJECT_PRODUCTION_URL=<provided-by-vercel>

# CI / deployment tooling
# CLI/CI deployment token.
VERCEL_TOKEN=<vercel-access-token>
# Vercel project owner/team ID.
VERCEL_ORG_ID=<vercel-team-or-user-id>
# Vercel project ID.
VERCEL_PROJECT_ID=<vercel-project-id>
# Playwright target application URL.
E2E_BASE_URL=https://game.rahmanef.com
# Playwright/release realtime readiness endpoint.
E2E_REALTIME_HEALTH_URL=https://game.rahmanef.com/api/realtime
# Optional Playwright Chrome executable override.
CHROME_PATH=<chrome-executable-path>
# Limits gameplay preview capture to one game.
PREVIEW_GAME_ID=<optional-game-id>
# Enables the Redis integration test when explicitly supplied.
REDIS_TEST_URL=<optional-redis-test-url>

# Internal runtime overrides
# HTTP/realtime bind host override.
HOST=0.0.0.0
# HTTP/realtime bind port override.
PORT=<platform-assigned-port>
# Static web root override.
WEB_ROOT=<optional-web-dist-path>
# Immutable game CDN filesystem root.
GAME_CDN_ROOT=<immutable-game-cdn-root>
# Realtime worker bundle override.
GAME_WORKER_PATH=<built-game-worker-path>
# Verified game module cache directory.
MODULE_CACHE_DIR=/tmp/play-together-game-modules
# Realtime WebSocket connect path override.
REALTIME_CONNECT_PATH=/api/realtime
