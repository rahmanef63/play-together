# VPS production runtime
# Put these values in: Private owner-only env file on the Play Together VPS checkout
# Copy this file to a non-example filename, replace every required placeholder, and never commit real secrets.
# IMPORTANT: never apply literal <placeholder> values to a live deployment.

# Public endpoints
# Source: Convex dashboard → deployment URL
# Browser-visible Convex deployment URL.
VITE_CONVEX_URL=https://upbeat-dog-398.convex.cloud
# Source: Project configuration / platform integration
# Browser-visible realtime URL. Production may leave this unset to use same-origin /api/realtime.
VITE_REALTIME_URL=
# Source: Project configuration / platform integration
# Public immutable game asset origin.
GAME_CDN_PUBLIC_ORIGIN=https://game.rahmanef.com
# Source: Project configuration / platform integration
# Exact browser origins accepted by realtime.
ALLOWED_ORIGINS=https://game.rahmanef.com
# Source: Project configuration / platform integration
# Exact origins allowed for game module loading.
GAME_MODULE_ORIGINS=https://games-game.rahmanef.com,https://game.rahmanef.com
# Source: Project configuration / platform integration
# Optional public-to-private module fetch routing map.
GAME_MODULE_FETCH_ORIGIN_MAP={"https://game.rahmanef.com":"http://web:8080"}
# Source: Project configuration / platform integration
# Allows HTTP game origins only for local development.
ALLOW_INSECURE_GAME_ORIGINS=false

# Shared security
# Source: Project configuration / platform integration
# Optional server CSP override; omit to use the hardened default.
CONTENT_SECURITY_POLICY=<optional-custom-csp>

# Managed production runtime
# Source: Primary Convex Cloud deployment URL
# Server-side Convex deployment used by VPS gateways to verify signed realtime and template tickets without copying their HMAC secrets onto the VPS.
TICKET_VERIFIER_CONVEX_URL=https://upbeat-dog-398.convex.cloud
# Source: Project runtime policy
# Fail-closed timeout for one-time Convex ticket verification during realtime/template authorization.
TICKET_VERIFIER_TIMEOUT_MS=5000
# Source: Existing Vercel Blob store → private VPS env
# Private template package Blob credential used by the VPS template download/package flow.
BLOB_READ_WRITE_TOKEN=<vercel-private-blob-token>
# Source: Managed Redis connection → private VPS env; VPS release-control publication uses the same owner-only value
# Cross-function room coordination and release-control Redis connection.
REDIS_URL=<managed-redis-connection-url>
# Source: Project configuration / platform integration
# Fails production realtime startup when Redis coordination/release-control is unavailable.
REQUIRE_DISTRIBUTED_COORDINATION=true
# Source: Project configuration / platform integration
# Requires release-control mirror reconciliation during managed publication.
RELEASE_CONTROL_REQUIRED=true
# Source: Project configuration / platform integration
# Realtime compatibility override; keep false outside explicit non-browser testing.
ALLOW_MISSING_ORIGIN=false
# Source: Project configuration / platform integration
# Room worker idle timeout.
ROOM_IDLE_TIMEOUT_MS=30000
# Source: Project configuration / platform integration
# Maximum realtime payload size.
MAX_PAYLOAD_BYTES=65536

# CI / deployment tooling
# Source: Canonical production domain / VPS deployment override
# Hostname routed by the VPS Traefik labels; may be overridden for a staging-origin validation.
VPS_HOST=game.rahmanef.com

# Internal runtime overrides
# Source: Project configuration / platform integration
# Verified game module cache directory.
MODULE_CACHE_DIR=/tmp/play-together/game-modules
