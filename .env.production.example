# Managed production target: Vercel + Convex Cloud.
# Copy values into each platform's secret store. Never commit populated secrets.

# Browser-visible Convex endpoint. VITE_REALTIME_URL is intentionally omitted:
# the managed client defaults to same-origin wss://<host>/api/realtime.
VITE_CONVEX_URL=https://your-production.convex.cloud

# Shared by Convex ticket issuance and Vercel realtime verification.
JOIN_TICKET_SECRET=

# Game release publication / origin policy.
GAME_PUBLISH_TOKEN=
GAME_CDN_PUBLIC_ORIGIN=https://game.rahmanef.com
ALLOWED_ORIGINS=https://game.rahmanef.com
GAME_MODULE_ORIGINS=https://game.rahmanef.com
GAME_MODULE_FETCH_ORIGIN_MAP={}
ALLOW_INSECURE_GAME_ORIGINS=false

# Convex Auth production configuration.
SITE_URL=https://game.rahmanef.com
JWT_PRIVATE_KEY=
JWKS=

# Shared transactional sender. Keep RESEND_API_KEY only on Convex/server side.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=official@rahmanef.com
EMAIL_PROJECT_NAME=Play Together
EMAIL_PROJECT_TAG=play-together
EMAIL_REPLY_TO=

# Private commercial template pipeline.
TEMPLATE_DOWNLOAD_SECRET=
TEMPLATE_PUBLISH_TOKEN=
TEMPLATE_SALES_WEBHOOK_SECRET=
# BLOB_READ_WRITE_TOKEN is injected by the connected Vercel Private Blob store.

ROOM_IDLE_TIMEOUT_MS=30000
MAX_PAYLOAD_BYTES=65536
# Required on Vercel managed production for cross-Function room coordination.
# Connected Vercel Redis injects this; do not expose it to Vite/browser code.
REDIS_URL=redis://localhost:6379
REQUIRE_DISTRIBUTED_COORDINATION=false
