# Reference production topology for game.rahmanef.com.
# Copy values into your deployment secret store. Do not commit a populated .env.
COMPOSE_PROJECT_NAME=play-together

VITE_CONVEX_URL=https://api-game.rahmanef.com
VITE_REALTIME_URL=wss://rt-game.rahmanef.com/v1/connect
GAME_CDN_PUBLIC_ORIGIN=https://games-game.rahmanef.com

ALLOWED_ORIGINS=https://game.rahmanef.com
GAME_MODULE_ORIGINS=https://games-game.rahmanef.com
GAME_MODULE_FETCH_ORIGIN_MAP={}
ALLOW_INSECURE_GAME_ORIGINS=false

# Generate strong unique values in the deployment secret store.
JOIN_TICKET_SECRET=
GAME_PUBLISH_TOKEN=
CONVEX_INSTANCE_SECRET=

CONVEX_INSTANCE_NAME=play-together-production
CONVEX_CLOUD_ORIGIN=https://api-game.rahmanef.com
CONVEX_SITE_ORIGIN=https://site-game.rahmanef.com
REDACT_LOGS_TO_CLIENT=true
DISABLE_METRICS_ENDPOINT=true
DISABLE_BEACON=true
DOCUMENT_RETENTION_DELAY=172800
ROOM_IDLE_TIMEOUT_MS=30000
MAX_PAYLOAD_BYTES=65536
