{
  "version": 1,
  "functions": [
    {
      "name": "game.list",
      "description": "List every discovered game slice, current version, controller topology, and immutable release state.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "list"],
      "timeoutMs": 10000
    },
    {
      "name": "game.get",
      "description": "Read one game config, package metadata, controller topology, and historical release records.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "get"],
      "timeoutMs": 10000
    },
    {
      "name": "game.create",
      "description": "Create one validated draft game vertical slice. This never publishes to production.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "minPlayers": {
            "type": "integer"
          },
          "maxPlayers": {
            "type": "integer"
          },
          "orientation": {
            "type": "string",
            "enum": ["portrait", "landscape", "adaptive"]
          },
          "layout": {
            "type": "string",
            "enum": ["gamepad", "arcade", "racing", "flight", "touch"]
          },
          "controls": {
            "type": "array",
            "description": "Declarative control tokens: stick, dpad, touchpad, a, b, x, y, l1, r1, l2, r2, start, select.",
            "items": {
              "type": "string"
            }
          },
          "modes": {
            "type": "array",
            "description": "Supported runtime modes.",
            "items": {
              "type": "string",
              "enum": ["shared-screen", "handheld"]
            }
          },
          "serverSource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          },
          "displaySource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          },
          "testSource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          }
        },
        "required": ["id", "title", "description", "minPlayers", "maxPlayers"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "create"],
      "timeoutMs": 30000
    },
    {
      "name": "game.update",
      "description": "Update one game slice with optimistic version protection. Published versions require a greater newVersion before any byte change.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "expectedVersion": {
            "type": "string",
            "description": "Semantic game version x.y.z."
          },
          "newVersion": {
            "type": "string",
            "description": "Semantic game version x.y.z."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "minPlayers": {
            "type": "integer"
          },
          "maxPlayers": {
            "type": "integer"
          },
          "orientation": {
            "type": "string",
            "enum": ["portrait", "landscape", "adaptive"]
          },
          "layout": {
            "type": "string",
            "enum": ["gamepad", "arcade", "racing", "flight", "touch"]
          },
          "controls": {
            "type": "array",
            "description": "Declarative control tokens: stick, dpad, touchpad, a, b, x, y, l1, r1, l2, r2, start, select.",
            "items": {
              "type": "string"
            }
          },
          "modes": {
            "type": "array",
            "description": "Supported runtime modes.",
            "items": {
              "type": "string",
              "enum": ["shared-screen", "handheld"]
            }
          },
          "serverSource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          },
          "displaySource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          },
          "testSource": {
            "type": "string",
            "description": "Optional complete TypeScript source. Values are written only inside the selected game slice."
          }
        },
        "required": ["id", "expectedVersion"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "update"],
      "timeoutMs": 15000
    },
    {
      "name": "game.delete",
      "description": "Delete an unpublished draft game slice. Refuses any game that already has an immutable release.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "delete"],
      "timeoutMs": 15000
    },
    {
      "name": "game.validate",
      "description": "Validate one game with discovery, TypeScript, unit tests, and bundle build without publishing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "validate"],
      "timeoutMs": 30000
    },
    {
      "name": "game.publish",
      "description": "Create one local immutable game release after validation. Production Convex registration remains main-branch CI only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Kebab-case game id under games/<id>.",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "publish"],
      "timeoutMs": 30000
    },
    {
      "name": "game.registry",
      "description": "Regenerate the dynamic portal game registry from all game.config.json slices.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "registry"],
      "timeoutMs": 15000
    },
    {
      "name": "game.prompt",
      "description": "Return the canonical full game-submission prompt extracted from docs/submitting-games.md.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": ["node", "scripts/game-tool.mjs", "prompt"],
      "timeoutMs": 10000
    }
  ]
}
