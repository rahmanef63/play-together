{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "turbo-circuit",
    "version": "0.9.2",
    "title": "Turbo Circuit",
    "description": "Server-authoritative multiplayer kart racing with procedural 3D tracks, dynamic game audio, drafting, boost pads, coins, items, hazards and simplified phone controls.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": [
    "shared-screen",
    "handheld"
  ],
  "runtimeDependencies": {
    "three": "0.185.1+pt1"
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steering and garage selection stick",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x",
              "menuY": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0,
              "menuY": 0
            }
          },
          "keys": {
            "left": [
              "ArrowLeft",
              "KeyA"
            ],
            "right": [
              "ArrowRight",
              "KeyD"
            ],
            "up": [
              "ArrowUp",
              "KeyW"
            ],
            "down": [
              "ArrowDown",
              "KeyS"
            ]
          }
        },
        {
          "id": "gas",
          "kind": "button",
          "label": "A",
          "displayLabel": "GAS",
          "ariaLabel": "Accelerate",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "throttle": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "throttle": 0
            }
          },
          "keys": [
            "ArrowUp",
            "KeyW"
          ]
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "B",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "b",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "brake": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": 0
            }
          },
          "keys": [
            "ArrowDown",
            "KeyS"
          ]
        },
        {
          "id": "item",
          "kind": "button",
          "label": "X",
          "displayLabel": "ITEM",
          "ariaLabel": "Use item ability",
          "face": "x",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "item",
              "direction": "forward"
            }
          },
          "keys": [
            "Space",
            "Enter",
            "KeyF"
          ]
        },
        {
          "id": "rear-view",
          "kind": "button",
          "label": "Y",
          "displayLabel": "REAR",
          "ariaLabel": "Hold rear view",
          "face": "y",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "rearView": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "rearView": false
            }
          },
          "keys": [
            "KeyR"
          ]
        },
        {
          "id": "start",
          "kind": "button",
          "label": "START",
          "displayLabel": "START",
          "ariaLabel": "Start ready or pause",
          "face": "start",
          "zone": "bottom",
          "press": {
            "type": "send",
            "payload": {
              "action": "start"
            }
          },
          "keys": [
            "Escape",
            "KeyP",
            "KeyG"
          ]
        }
      ],
      "initialState": {
        "steer": 0,
        "menuY": 0,
        "throttle": 0,
        "brake": 0,
        "drift": false,
        "rearView": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  },
  "entries": {
    "display": {
      "url": "./display.js",
      "sha256": "7d44d117ed1fc11314de8bd2cd85663d4c62637a3efa4fbd8dc2212b7270e6b7"
    },
    "server": {
      "url": "./server.js",
      "sha256": "58e054d37b3b3ff9a6c94c6d14e8cf11979c2aeb40d32e7eff06a38a29b1afe8"
    }
  }
}
