{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "turbo-circuit",
    "version": "0.4.1",
    "title": "Turbo Circuit",
    "description": "A hybrid 2.5D arcade circuit racer with verified directional car sprites, forgiving steering, readable track landmarks, minimap, nitro, checkpoints, collisions and AI rivals.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": [
    "shared-screen",
    "handheld"
  ],
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steering stick",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0
            }
          },
          "keys": {
            "left": [
              "ArrowLeft",
              "KeyA"
            ],
            "right": [
              "ArrowRight",
              "KeyD"
            ]
          }
        },
        {
          "id": "throttle",
          "kind": "button",
          "label": "GAS",
          "ariaLabel": "Accelerate",
          "face": "r2",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "throttle": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "throttle": 0
            }
          },
          "keys": [
            "ArrowUp",
            "KeyW"
          ]
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "BRAKE",
          "ariaLabel": "Brake",
          "face": "l2",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "brake": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": 0
            }
          },
          "keys": [
            "ArrowDown",
            "KeyS"
          ]
        },
        {
          "id": "boost",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Nitro boost",
          "face": "a",
          "zone": "bottom-right",
          "press": {
            "type": "patch",
            "values": {
              "boost": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "boost": false
            }
          },
          "keys": [
            "Space"
          ],
          "displayLabel": "BOOST"
        }
      ],
      "initialState": {
        "steer": 0,
        "throttle": 0,
        "brake": 0,
        "boost": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  },
  "entries": {
    "display": {
      "url": "./display.js",
      "sha256": "412b8753b2449bd21cdaacd2b25a8c1dfb2413e6148671de8167a18bd43a4780"
    },
    "server": {
      "url": "./server.js",
      "sha256": "630c635301485a943499b67ff69a708bbc559b4dcfb094dc46a076012f7c46f0"
    }
  },
  "assets": {
    "vehicle.red.atlas": {
      "url": "./assets/vehicle-red-atlas.png",
      "sha256": "77d2033c3baeeff4ef6b3c1220fd7e4458da316b97206f65519da9ea0dfc3373",
      "contentType": "image/png",
      "bytes": 648252
    },
    "vehicle.red.frames": {
      "url": "./assets/vehicle-red-atlas.json",
      "sha256": "69cef2480d2c8cef5e8a59786f74b31fe7867667b3a8140d20ec15a8adedb4df",
      "contentType": "application/json",
      "bytes": 1830
    }
  }
}
