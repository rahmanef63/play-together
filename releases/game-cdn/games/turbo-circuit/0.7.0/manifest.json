{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "turbo-circuit",
    "version": "0.7.0",
    "title": "Turbo Circuit",
    "description": "A mobile-first real-circuit racer with PS1-style garage flow, auto-throttle, A/B/C/D console controls, server-authoritative pause, chase/driver/rear cameras, a dynamic SVG cockpit, nitro, collisions, and chaotic CPU rivals.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": [
    "shared-screen",
    "handheld"
  ],
  "runtimeDependencies": {
    "three": "0.185.1+pt1"
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steering and garage selection stick",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x",
              "menuY": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0,
              "menuY": 0
            }
          },
          "keys": {
            "left": [
              "ArrowLeft",
              "KeyA"
            ],
            "right": [
              "ArrowRight",
              "KeyD"
            ],
            "up": [
              "KeyW"
            ],
            "down": [
              "KeyS"
            ]
          }
        },
        {
          "id": "boost",
          "kind": "button",
          "label": "A",
          "displayLabel": "BOOST",
          "ariaLabel": "Nitro boost",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "boost": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "boost": false
            }
          },
          "keys": [
            "Space"
          ]
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "B",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "b",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "brake": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": 0
            }
          },
          "keys": [
            "ArrowDown"
          ]
        },
        {
          "id": "camera",
          "kind": "button",
          "label": "C",
          "displayLabel": "VIEW",
          "ariaLabel": "Toggle chase or driver camera",
          "face": "c",
          "zone": "right",
          "press": {
            "type": "toggle",
            "field": "cockpit"
          },
          "keys": [
            "KeyV"
          ]
        },
        {
          "id": "rear-view",
          "kind": "button",
          "label": "D",
          "displayLabel": "REAR",
          "ariaLabel": "Hold rear view",
          "face": "d",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "rearView": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "rearView": false
            }
          },
          "keys": [
            "KeyR"
          ]
        },
        {
          "id": "start",
          "kind": "button",
          "label": "START",
          "ariaLabel": "Ready and start race",
          "face": "start",
          "zone": "bottom",
          "press": {
            "type": "send",
            "payload": {
              "drive": true
            }
          },
          "keys": [
            "Enter",
            "KeyG"
          ]
        },
        {
          "id": "pause",
          "kind": "button",
          "label": "PAUSE",
          "ariaLabel": "Pause or resume race",
          "face": "pause",
          "zone": "bottom",
          "press": {
            "type": "pulse",
            "values": {
              "pause": true
            },
            "releaseValues": {
              "pause": false
            },
            "durationMs": 80
          },
          "keys": [
            "Escape",
            "KeyP"
          ]
        }
      ],
      "initialState": {
        "steer": 0,
        "menuY": 0,
        "brake": 0,
        "boost": false,
        "cockpit": false,
        "rearView": false,
        "pause": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  },
  "entries": {
    "display": {
      "url": "./display.js",
      "sha256": "6128b0a63020d41d6fb3df5ba6a7dcac928539e8ef6a415f1be3054380f65cb4"
    },
    "server": {
      "url": "./server.js",
      "sha256": "9fad9cb2f3cf29f50e3a07666a2645ae61aec768f91399ab357b59afd535853a"
    }
  },
  "assets": {
    "vehicle.red.atlas": {
      "url": "./assets/vehicle-red-atlas.png",
      "sha256": "77d2033c3baeeff4ef6b3c1220fd7e4458da316b97206f65519da9ea0dfc3373",
      "contentType": "image/png",
      "bytes": 648252
    },
    "vehicle.red.frames": {
      "url": "./assets/vehicle-red-atlas.json",
      "sha256": "69cef2480d2c8cef5e8a59786f74b31fe7867667b3a8140d20ec15a8adedb4df",
      "contentType": "application/json",
      "bytes": 1830
    }
  }
}
