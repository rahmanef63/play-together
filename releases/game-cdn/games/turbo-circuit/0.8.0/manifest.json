{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "turbo-circuit",
    "version": "0.8.0",
    "title": "Turbo Circuit",
    "description": "A server-authoritative 3D kart racer with manual throttle, drifting and mini-turbos, slipstream drafting, boost pads, coins, item boxes, hazards, rescue, four camera modes and CPU rivals.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": [
    "shared-screen",
    "handheld"
  ],
  "runtimeDependencies": {
    "three": "0.185.1+pt1"
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steering and garage selection stick",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x",
              "menuY": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0,
              "menuY": 0
            }
          },
          "keys": {
            "left": [
              "ArrowLeft",
              "KeyA"
            ],
            "right": [
              "ArrowRight",
              "KeyD"
            ],
            "up": [
              "KeyW"
            ],
            "down": [
              "KeyS"
            ]
          }
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "L2",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "l2",
          "zone": "top-left",
          "press": {
            "type": "patch",
            "values": {
              "brake": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": 0
            }
          },
          "keys": [
            "ArrowDown",
            "KeyS"
          ]
        },
        {
          "id": "rear-view",
          "kind": "button",
          "label": "L1",
          "displayLabel": "REAR",
          "ariaLabel": "Hold rear view",
          "face": "l1",
          "zone": "top-left",
          "press": {
            "type": "patch",
            "values": {
              "rearView": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "rearView": false
            }
          },
          "keys": [
            "KeyB"
          ]
        },
        {
          "id": "throttle",
          "kind": "button",
          "label": "R2",
          "displayLabel": "GAS",
          "ariaLabel": "Accelerate",
          "face": "r2",
          "zone": "top-right",
          "press": {
            "type": "patch",
            "values": {
              "throttle": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "throttle": 0
            }
          },
          "keys": [
            "ArrowUp",
            "KeyW"
          ]
        },
        {
          "id": "item-back",
          "kind": "button",
          "label": "R1",
          "displayLabel": "ITEM ↓",
          "ariaLabel": "Use item backward",
          "face": "r1",
          "zone": "top-right",
          "press": {
            "type": "send",
            "payload": {
              "action": "item",
              "direction": "backward"
            }
          },
          "keys": [
            "KeyF"
          ]
        },
        {
          "id": "item",
          "kind": "button",
          "label": "A",
          "displayLabel": "ITEM",
          "ariaLabel": "Use item forward",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "item",
              "direction": "forward"
            }
          },
          "keys": [
            "Space",
            "Enter"
          ]
        },
        {
          "id": "drift",
          "kind": "button",
          "label": "B",
          "displayLabel": "DRIFT",
          "ariaLabel": "Hold drift",
          "face": "b",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "drift": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "drift": false
            }
          },
          "keys": [
            "ShiftLeft",
            "ShiftRight"
          ]
        },
        {
          "id": "camera",
          "kind": "button",
          "label": "X",
          "displayLabel": "VIEW",
          "ariaLabel": "Cycle camera",
          "face": "x",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "camera"
            }
          },
          "keys": [
            "KeyC",
            "KeyV"
          ]
        },
        {
          "id": "rescue",
          "kind": "button",
          "label": "Y",
          "displayLabel": "RESET",
          "ariaLabel": "Rescue kart to track",
          "face": "y",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "rescue"
            }
          },
          "keys": [
            "KeyR"
          ]
        },
        {
          "id": "start",
          "kind": "button",
          "label": "START",
          "displayLabel": "READY",
          "ariaLabel": "Ready and start race",
          "face": "start",
          "zone": "bottom",
          "press": {
            "type": "send",
            "payload": {
              "action": "ready"
            }
          },
          "keys": [
            "KeyG"
          ]
        },
        {
          "id": "pause",
          "kind": "button",
          "label": "PAUSE",
          "ariaLabel": "Pause or resume race",
          "face": "pause",
          "zone": "bottom",
          "press": {
            "type": "send",
            "payload": {
              "action": "pause"
            }
          },
          "keys": [
            "Escape",
            "KeyP"
          ]
        }
      ],
      "initialState": {
        "steer": 0,
        "menuY": 0,
        "throttle": 0,
        "brake": 0,
        "drift": false,
        "rearView": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  },
  "entries": {
    "display": {
      "url": "./display.js",
      "sha256": "ccf4189698c9d9c9add6114253b7546124edbc099b00b8aec4112ec51fdd3140"
    },
    "server": {
      "url": "./server.js",
      "sha256": "a4aff12c082c1a723f63f892f66e3c0d3ca18269a898ac40449b2a3d332ac5a6"
    }
  },
  "assets": {
    "vehicle.red.atlas": {
      "url": "./assets/vehicle-red-atlas.png",
      "sha256": "77d2033c3baeeff4ef6b3c1220fd7e4458da316b97206f65519da9ea0dfc3373",
      "contentType": "image/png",
      "bytes": 648252
    },
    "vehicle.red.frames": {
      "url": "./assets/vehicle-red-atlas.json",
      "sha256": "69cef2480d2c8cef5e8a59786f74b31fe7867667b3a8140d20ec15a8adedb4df",
      "contentType": "application/json",
      "bytes": 1830
    }
  }
}
