{
  "schemaVersion": 1,
  "games": [
    {
      "id": "dodge-dash",
      "version": "0.3.1",
      "title": "Dodge Dash",
      "description": "An endless lane dodger where players weave around incoming hazards for survival score.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": true,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "shared",
          "maxViewports": 1
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "adaptive",
        "console": {
          "renderer": "builtin",
          "layout": "gamepad",
          "controls": [
            {
              "id": "move",
              "kind": "stick",
              "ariaLabel": "Dodge left or right",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "move": "$x"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "move": 0
                }
              },
              "keys": {
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"]
              }
            }
          ],
          "initialState": {
            "move": 0
          }
        }
      },
      "previewUrl": "/game-previews/dodge-dash.png"
    },
    {
      "id": "flight-trainer",
      "version": "0.2.3",
      "title": "Flight Trainer",
      "description": "A 3D flight-training simulator with throttle, pitch, roll, yaw, flaps, landing gear, stall/crash physics, instruments and checkpoint navigation.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": false,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "per-player",
          "maxViewports": 4
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "flight",
          "controls": [
            {
              "id": "yoke",
              "kind": "stick",
              "ariaLabel": "Flight yoke",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "roll": "$x",
                  "pitch": "$y"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "roll": 0,
                  "pitch": 0
                }
              },
              "keys": {
                "up": ["ArrowUp", "KeyW"],
                "down": ["ArrowDown", "KeyS"],
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"]
              }
            },
            {
              "id": "yaw-left",
              "kind": "button",
              "label": "L1",
              "ariaLabel": "Yaw left",
              "face": "l1",
              "zone": "top-left",
              "press": {
                "type": "patch",
                "values": {
                  "yaw": -1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "yaw": 0
                }
              },
              "keys": ["KeyQ"],
              "displayLabel": "YAW L"
            },
            {
              "id": "yaw-right",
              "kind": "button",
              "label": "R1",
              "ariaLabel": "Yaw right",
              "face": "r1",
              "zone": "top-right",
              "press": {
                "type": "patch",
                "values": {
                  "yaw": 1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "yaw": 0
                }
              },
              "keys": ["KeyE"],
              "displayLabel": "YAW R"
            },
            {
              "id": "flaps",
              "kind": "button",
              "label": "A",
              "ariaLabel": "Toggle flaps",
              "face": "a",
              "zone": "right",
              "press": {
                "type": "toggle",
                "field": "flaps"
              },
              "displayLabel": "FLAPS"
            },
            {
              "id": "gear",
              "kind": "button",
              "label": "B",
              "ariaLabel": "Toggle landing gear",
              "face": "b",
              "zone": "right",
              "press": {
                "type": "toggle",
                "field": "gear"
              },
              "displayLabel": "GEAR"
            },
            {
              "id": "throttle-up",
              "kind": "button",
              "label": "Y",
              "ariaLabel": "Throttle up",
              "face": "y",
              "zone": "right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": 0.12,
                "min": 0,
                "max": 1
              },
              "keys": ["Equal"],
              "displayLabel": "THR +"
            },
            {
              "id": "throttle-down",
              "kind": "button",
              "label": "X",
              "ariaLabel": "Throttle down",
              "face": "x",
              "zone": "right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": -0.12,
                "min": 0,
                "max": 1
              },
              "keys": ["Minus"],
              "displayLabel": "THR −"
            },
            {
              "id": "restart",
              "kind": "button",
              "label": "START",
              "ariaLabel": "Restart flight",
              "face": "start",
              "zone": "bottom",
              "press": {
                "type": "pulse",
                "values": {
                  "restart": true
                },
                "releaseValues": {
                  "restart": false
                },
                "durationMs": 80
              },
              "displayLabel": "RESTART"
            }
          ],
          "initialState": {
            "pitch": 0,
            "roll": 0,
            "yaw": 0,
            "throttle": 0,
            "flaps": false,
            "gear": true,
            "restart": false
          }
        }
      },
      "previewUrl": "/game-previews/flight-trainer.png"
    },
