{
  "schemaVersion": 1,
  "games": [
    {
      "id": "clash-arena",
      "version": "0.4.1",
      "title": "Clash Arena",
      "description": "Original 1v1 arena fighter with character select, asset-backed 3D fighters, directional guard, meter, throw escape and deterministic combat.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": true,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "shared",
          "maxViewports": 1
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "arcade",
          "initialState": {
            "x": 0,
            "y": 0,
            "a": false,
            "b": false,
            "xButton": false,
            "yButton": false,
            "start": false
          },
          "controls": [
            {
              "id": "move",
              "kind": "stick",
              "ariaLabel": "Choose fighter before match; move and guard during fight",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "x": "$x",
                  "y": "$y"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "x": 0,
                  "y": 0
                }
              },
              "keys": {
                "up": ["ArrowUp", "KeyW"],
                "down": ["ArrowDown", "KeyS"],
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"]
              }
            },
            {
              "id": "jab",
              "kind": "button",
              "label": "A",
              "displayLabel": "SELECT / JAB",
              "ariaLabel": "Select fighter before match; jab during fight; press with B to escape a throw",
              "face": "a",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "a": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "a": false
                }
              },
              "keys": ["KeyJ"]
            },
            {
              "id": "kick",
              "kind": "button",
              "label": "B",
              "displayLabel": "BACK / KICK",
              "ariaLabel": "Unready during fighter select; kick during fight; press with A to escape a throw",
              "face": "b",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "b": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "b": false
                }
              },
              "keys": ["KeyK"]
            },
            {
              "id": "strike",
              "kind": "button",
              "label": "X",
              "displayLabel": "LAUNCH / LOW",
              "ariaLabel": "Launcher; crouch plus X performs a low sweep",
              "face": "x",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "xButton": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "xButton": false
                }
              },
              "keys": ["KeyL"]
            },
            {
              "id": "surge",
              "kind": "button",
              "label": "Y",
              "displayLabel": "METER SURGE",
              "ariaLabel": "Spend meter for Surge",
              "face": "y",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "yButton": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "yButton": false
                }
              },
              "keys": ["KeyI"]
            },
            {
              "id": "start",
              "kind": "button",
              "label": "START",
              "displayLabel": "READY / REMATCH",
              "ariaLabel": "Confirm fighter before match; request rematch after match",
              "face": "start",
              "zone": "bottom",
              "press": {
                "type": "patch",
                "values": {
                  "start": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "start": false
                }
              },
              "keys": ["Enter"]
            }
          ]
        }
      },
      "previewUrl": "/game-previews/clash-arena.png"
    },
    {
      "id": "flight-trainer",
      "version": "0.4.1",
      "title": "Flight Trainer",
      "description": "A 3D flight-training simulator with throttle, pitch, roll, yaw, flaps, landing gear, stall/crash physics, instruments and checkpoint navigation.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": true,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "per-player",
          "maxViewports": 4
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "flight",
