{
  "schemaVersion": 1,
  "games": [
    {
      "id": "flight-trainer",
      "version": "0.2.6",
      "title": "Flight Trainer",
      "description": "A 3D flight-training simulator with throttle, pitch, roll, yaw, flaps, landing gear, stall/crash physics, instruments and checkpoint navigation.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": false,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "per-player",
          "maxViewports": 4
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "flight",
          "controls": [
            {
              "id": "yoke",
              "kind": "stick",
              "ariaLabel": "Flight yoke",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "roll": "$x",
                  "pitch": "$y"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "roll": 0,
                  "pitch": 0
                }
              },
              "keys": {
                "up": ["ArrowUp", "KeyW"],
                "down": ["ArrowDown", "KeyS"],
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"]
              }
            },
            {
              "id": "yaw-left",
              "kind": "button",
              "label": "L1",
              "ariaLabel": "Yaw left",
              "face": "l1",
              "zone": "top-left",
              "press": {
                "type": "patch",
                "values": {
                  "yaw": -1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "yaw": 0
                }
              },
              "keys": ["KeyQ"],
              "displayLabel": "YAW L"
            },
            {
              "id": "yaw-right",
              "kind": "button",
              "label": "R1",
              "ariaLabel": "Yaw right",
              "face": "r1",
              "zone": "top-right",
              "press": {
                "type": "patch",
                "values": {
                  "yaw": 1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "yaw": 0
                }
              },
              "keys": ["KeyE"],
              "displayLabel": "YAW R"
            },
            {
              "id": "flaps",
              "kind": "button",
              "label": "A",
              "ariaLabel": "Toggle flaps",
              "face": "a",
              "zone": "right",
              "press": {
                "type": "toggle",
                "field": "flaps"
              },
              "displayLabel": "FLAPS"
            },
            {
              "id": "gear",
              "kind": "button",
              "label": "B",
              "ariaLabel": "Toggle landing gear",
              "face": "b",
              "zone": "right",
              "press": {
                "type": "toggle",
                "field": "gear"
              },
              "displayLabel": "GEAR"
            },
            {
              "id": "throttle-up",
              "kind": "button",
              "label": "Y",
              "ariaLabel": "Throttle up",
              "face": "y",
              "zone": "right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": 0.12,
                "min": 0,
                "max": 1
              },
              "keys": ["Equal"],
              "displayLabel": "THR +"
            },
            {
              "id": "throttle-down",
              "kind": "button",
              "label": "X",
              "ariaLabel": "Throttle down",
              "face": "x",
              "zone": "right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": -0.12,
                "min": 0,
                "max": 1
              },
              "keys": ["Minus"],
              "displayLabel": "THR −"
            },
            {
              "id": "restart",
              "kind": "button",
              "label": "START",
              "ariaLabel": "Restart flight",
              "face": "start",
              "zone": "bottom",
              "press": {
                "type": "pulse",
                "values": {
                  "restart": true
                },
                "releaseValues": {
                  "restart": false
                },
                "durationMs": 80
              },
              "displayLabel": "RESTART"
            }
          ],
          "initialState": {
            "pitch": 0,
            "roll": 0,
            "yaw": 0,
            "throttle": 0,
            "flaps": false,
            "gear": true,
            "restart": false
          }
        }
      },
      "previewUrl": "/game-previews/flight-trainer.png"
    },
    {
      "id": "sky-strike",
      "version": "0.2.6",
      "title": "Sky Strike",
      "description": "A 3D arcade fighter dogfight with flight controls, cannon fire, homing missiles, lock-on, health, respawns and AI bandits.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": false,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "per-player",
          "maxViewports": 4
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "flight",
          "controls": [
            {
              "id": "flight-stick",
              "kind": "stick",
              "ariaLabel": "Flight stick",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "roll": "$x",
                  "pitch": "$y"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "roll": 0,
                  "pitch": 0
                }
              },
              "keys": {
                "up": ["ArrowUp", "KeyW"],
                "down": ["ArrowDown", "KeyS"],
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"]
              }
            },
            {
              "id": "gun",
              "kind": "button",
              "label": "A",
              "ariaLabel": "Fire cannon",
              "face": "a",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "gun": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "gun": false
                }
              },
              "keys": ["Space"],
              "displayLabel": "CANNON"
            },
            {
              "id": "missile",
              "kind": "button",
              "label": "B",
              "ariaLabel": "Fire missile",
              "face": "b",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "missile": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "missile": false
                }
              },
              "keys": ["ShiftLeft", "ShiftRight"],
              "displayLabel": "MISSILE"
            },
            {
              "id": "throttle-up",
              "kind": "button",
              "label": "Y",
              "ariaLabel": "Increase throttle",
              "face": "y",
              "zone": "top-right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": 0.1,
                "min": 0,
                "max": 1
              },
              "keys": ["Equal"],
              "displayLabel": "THR +"
            },
            {
              "id": "throttle-down",
              "kind": "button",
              "label": "X",
              "ariaLabel": "Decrease throttle",
              "face": "x",
              "zone": "bottom-right",
              "press": {
                "type": "increment",
                "field": "throttle",
                "delta": -0.1,
                "min": 0,
                "max": 1
              },
              "keys": ["Minus"],
              "displayLabel": "THR −"
            }
          ],
          "initialState": {
            "pitch": 0,
            "roll": 0,
            "yaw": 0,
            "throttle": 0.65,
            "gun": false,
            "missile": false
          }
        }
      },
      "previewUrl": "/game-previews/sky-strike.png"
    },
    {
      "id": "turbo-circuit",
      "version": "0.9.2",
      "title": "Turbo Circuit",
      "description": "Server-authoritative multiplayer kart racing with procedural 3D tracks, dynamic game audio, drafting, boost pads, coins, items, hazards and simplified phone controls.",
      "modes": ["shared-screen", "handheld"],
      "capabilities": {
        "touch": true,
        "keyboard": true,
        "gamepad": false,
        "motion": false
      },
      "presentation": {
        "remoteDisplay": {
          "mode": "per-player",
          "maxViewports": 4
        }
      },
      "controller": {
        "supportsRemote": true,
        "supportsHandheld": true,
        "preferredOrientation": "landscape",
        "console": {
          "renderer": "builtin",
          "layout": "racing",
          "controls": [
            {
              "id": "steer",
              "kind": "stick",
              "ariaLabel": "Steering and garage selection stick",
              "zone": "left",
              "action": {
                "type": "patch",
                "values": {
                  "steer": "$x",
                  "menuY": "$y"
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "steer": 0,
                  "menuY": 0
                }
              },
              "keys": {
                "left": ["ArrowLeft", "KeyA"],
                "right": ["ArrowRight", "KeyD"],
                "up": ["ArrowUp", "KeyW"],
                "down": ["ArrowDown", "KeyS"]
              }
            },
            {
              "id": "gas",
              "kind": "button",
              "label": "A",
              "displayLabel": "GAS",
              "ariaLabel": "Accelerate",
              "face": "a",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "throttle": 1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "throttle": 0
                }
              },
              "keys": ["ArrowUp", "KeyW"]
            },
            {
              "id": "brake",
              "kind": "button",
              "label": "B",
              "displayLabel": "BRAKE",
              "ariaLabel": "Brake",
              "face": "b",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "brake": 1
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "brake": 0
                }
              },
              "keys": ["ArrowDown", "KeyS"]
            },
            {
              "id": "item",
              "kind": "button",
              "label": "X",
              "displayLabel": "ITEM",
              "ariaLabel": "Use item ability",
              "face": "x",
              "zone": "right",
              "press": {
                "type": "send",
                "payload": {
                  "action": "item",
                  "direction": "forward"
                }
              },
              "keys": ["Space", "Enter", "KeyF"]
            },
            {
              "id": "rear-view",
              "kind": "button",
              "label": "Y",
              "displayLabel": "REAR",
              "ariaLabel": "Hold rear view",
              "face": "y",
              "zone": "right",
              "press": {
                "type": "patch",
                "values": {
                  "rearView": true
                }
              },
              "release": {
                "type": "patch",
                "values": {
                  "rearView": false
                }
              },
              "keys": ["KeyR"]
            },
            {
              "id": "start",
              "kind": "button",
              "label": "START",
              "displayLabel": "START",
              "ariaLabel": "Start ready or pause",
              "face": "start",
              "zone": "bottom",
              "press": {
                "type": "send",
                "payload": {
                  "action": "start"
                }
              },
              "keys": ["Escape", "KeyP", "KeyG"]
            }
          ],
          "initialState": {
            "steer": 0,
            "menuY": 0,
            "throttle": 0,
            "brake": 0,
            "drift": false,
            "rearView": false
          }
        }
      },
      "previewUrl": "/game-previews/turbo-circuit.png"
    }
  ]
}
