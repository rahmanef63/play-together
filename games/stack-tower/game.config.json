{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "stack-tower",
    "version": "0.3.0",
    "title": "Stack Tower",
    "description": "A timing-based tower race where every drop must overlap the block below.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": ["shared-screen", "handheld"],
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "portrait",
    "console": {
      "renderer": "builtin",
      "layout": "arcade",
      "controls": [
        {
          "id": "drop",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Drop block",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "drop"
            }
          },
          "keys": ["Space", "Enter"]
        }
      ]
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  }
}
