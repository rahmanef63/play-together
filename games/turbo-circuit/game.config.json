{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "turbo-circuit",
    "version": "0.5.3",
    "title": "Turbo Circuit",
    "description": "A PS1-inspired couple circuit racer with car and circuit selection, auto-throttle, chase/driver cameras, analog speedometer, dynamic tracks, nitro, checkpoints, collisions, and racing-line CPU rivals driven by bounded chaotic variation.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": ["shared-screen", "handheld"],
  "runtimeDependencies": {
    "three": "0.185.1+pt1"
  },
  "presentation": {
    "remoteDisplay": {
      "mode": "per-player",
      "maxViewports": 4
    }
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steering and garage selection stick",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x",
              "menuY": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0,
              "menuY": 0
            }
          },
          "keys": {
            "left": ["ArrowLeft", "KeyA"],
            "right": ["ArrowRight", "KeyD"],
            "up": ["KeyW"],
            "down": ["KeyS"]
          }
        },
        {
          "id": "drive",
          "kind": "button",
          "label": "GO",
          "displayLabel": "GO",
          "ariaLabel": "Ready and start auto drive",
          "face": "r2",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "drive": true
            }
          },
          "keys": ["Enter", "KeyG"]
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "BRAKE",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "l2",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "brake": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": 0
            }
          },
          "keys": ["ArrowDown"]
        },
        {
          "id": "boost",
          "kind": "button",
          "label": "BOOST",
          "displayLabel": "BOOST",
          "ariaLabel": "Nitro boost",
          "face": "a",
          "zone": "bottom-right",
          "press": {
            "type": "patch",
            "values": {
              "boost": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "boost": false
            }
          },
          "keys": ["Space"]
        },
        {
          "id": "camera",
          "kind": "button",
          "label": "VIEW",
          "displayLabel": "VIEW",
          "ariaLabel": "Toggle chase or driver camera",
          "face": "y",
          "zone": "bottom-right",
          "press": {
            "type": "toggle",
            "field": "cockpit"
          },
          "keys": ["KeyV"]
        }
      ],
      "initialState": {
        "steer": 0,
        "menuY": 0,
        "brake": 0,
        "boost": false,
        "cockpit": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  }
}
