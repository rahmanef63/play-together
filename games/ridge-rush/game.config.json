{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "ridge-rush",
    "version": "0.3.2",
    "title": "Ridge Rush",
    "description": "Extreme 3D mountain-bike descent with cliffside singletrack, deep vertical drops, gravity, wheel-weight transfer, surface grip, jumps, checkpoints and deterministic rivals.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": ["shared-screen", "handheld"],
  "presentation": {
    "remoteDisplay": {
      "mode": "shared",
      "maxViewports": 1
    }
  },
  "runtimeDependencies": {
    "three": "0.185.1+pt2"
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "racing",
      "initialState": {
        "steer": 0,
        "body": 0,
        "pedal": false,
        "brake": false,
        "jump": false,
        "rear": false
      },
      "controls": [
        {
          "id": "steer",
          "kind": "stick",
          "ariaLabel": "Steer and shift body weight",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "steer": "$x",
              "body": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "steer": 0,
              "body": 0
            }
          },
          "keys": {
            "up": ["ArrowUp", "KeyW"],
            "down": ["ArrowDown", "KeyS"],
            "left": ["ArrowLeft", "KeyA"],
            "right": ["ArrowRight", "KeyD"]
          }
        },
        {
          "id": "pedal",
          "kind": "button",
          "label": "A",
          "displayLabel": "PEDAL",
          "ariaLabel": "Pedal",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "pedal": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "pedal": false
            }
          },
          "keys": ["Space"]
        },
        {
          "id": "brake",
          "kind": "button",
          "label": "B",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "b",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "brake": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": false
            }
          },
          "keys": ["ShiftLeft", "ShiftRight"]
        },
        {
          "id": "jump",
          "kind": "button",
          "label": "X",
          "displayLabel": "JUMP",
          "ariaLabel": "Jump or pump",
          "face": "x",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "jump": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "jump": false
            }
          },
          "keys": ["KeyX"]
        },
        {
          "id": "rear-view",
          "kind": "button",
          "label": "Y",
          "displayLabel": "REAR",
          "ariaLabel": "Hold rear view",
          "face": "y",
          "zone": "right",
          "press": {
            "type": "patch",
            "values": {
              "rear": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "rear": false
            }
          },
          "keys": ["KeyY"]
        },
        {
          "id": "start",
          "kind": "button",
          "label": "START",
          "displayLabel": "READY",
          "ariaLabel": "Ready or request rematch",
          "face": "start",
          "zone": "bottom",
          "press": {
            "type": "send",
            "payload": {
              "action": "ready"
            }
          },
          "keys": ["Enter"]
        }
      ]
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": true,
    "motion": false
  }
}
