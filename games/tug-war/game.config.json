{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "tug-war",
    "version": "0.3.0",
    "title": "Tug War",
    "description": "Two teams hammer their PULL controls to drag the rope across the finish line.",
    "minPlayers": 2,
    "maxPlayers": 8,
    "tickRate": 30,
    "snapshotRate": 15
  },
  "modes": ["shared-screen", "handheld"],
  "presentation": {
    "remoteDisplay": {
      "mode": "shared",
      "maxViewports": 1
    }
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "portrait",
    "console": {
      "renderer": "builtin",
      "layout": "arcade",
      "controls": [
        {
          "id": "pull",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Pull rope",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "pull"
            }
          },
          "keys": ["Space", "Enter"]
        }
      ]
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  }
}
