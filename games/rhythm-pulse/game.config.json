{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "rhythm-pulse",
    "version": "0.3.0",
    "title": "Rhythm Pulse",
    "description": "A timing game that scores taps by how close they land to the shared pulse.",
    "minPlayers": 1,
    "maxPlayers": 8,
    "tickRate": 60,
    "snapshotRate": 30
  },
  "modes": ["shared-screen", "handheld"],
  "presentation": {
    "remoteDisplay": {
      "mode": "shared",
      "maxViewports": 1
    }
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "portrait",
    "console": {
      "renderer": "builtin",
      "layout": "arcade",
      "controls": [
        {
          "id": "tap",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Tap on beat",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "tap"
            }
          },
          "keys": ["Space", "Enter"]
        }
      ]
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  }
}
