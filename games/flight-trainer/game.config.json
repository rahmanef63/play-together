{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "flight-trainer",
    "version": "0.3.0",
    "title": "Flight Trainer",
    "description": "A 3D flight-training simulator with throttle, pitch, roll, yaw, flaps, landing gear, stall/crash physics, instruments and checkpoint navigation.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": ["shared-screen", "handheld"],
  "runtimeDependencies": {
    "three": "0.185.1+pt1"
  },
  "presentation": {
    "remoteDisplay": {
      "mode": "per-player",
      "maxViewports": 4
    }
  },
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "landscape",
    "console": {
      "renderer": "builtin",
      "layout": "flight",
      "controls": [
        {
          "id": "yoke",
          "kind": "stick",
          "ariaLabel": "Flight yoke",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "roll": "$x",
              "pitch": "$y"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "roll": 0,
              "pitch": 0
            }
          },
          "keys": {
            "up": ["ArrowUp", "KeyW"],
            "down": ["ArrowDown", "KeyS"],
            "left": ["ArrowLeft", "KeyA"],
            "right": ["ArrowRight", "KeyD"]
          }
        },
        {
          "id": "yaw-left",
          "kind": "button",
          "label": "L1",
          "ariaLabel": "Yaw left",
          "face": "l1",
          "zone": "top-left",
          "press": {
            "type": "patch",
            "values": {
              "yaw": -1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "yaw": 0
            }
          },
          "keys": ["KeyQ"],
          "displayLabel": "YAW L"
        },
        {
          "id": "yaw-right",
          "kind": "button",
          "label": "R1",
          "ariaLabel": "Yaw right",
          "face": "r1",
          "zone": "top-right",
          "press": {
            "type": "patch",
            "values": {
              "yaw": 1
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "yaw": 0
            }
          },
          "keys": ["KeyE"],
          "displayLabel": "YAW R"
        },
        {
          "id": "flaps",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Toggle flaps",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "toggle",
            "field": "flaps"
          },
          "displayLabel": "FLAPS",
          "keys": ["KeyF"]
        },
        {
          "id": "gear",
          "kind": "button",
          "label": "B",
          "ariaLabel": "Toggle landing gear",
          "face": "b",
          "zone": "right",
          "press": {
            "type": "toggle",
            "field": "gear"
          },
          "displayLabel": "GEAR",
          "keys": ["KeyG"]
        },
        {
          "id": "throttle-up",
          "kind": "button",
          "label": "Y",
          "ariaLabel": "Throttle up",
          "face": "y",
          "zone": "right",
          "press": {
            "type": "increment",
            "field": "throttle",
            "delta": 0.12,
            "min": 0,
            "max": 1
          },
          "keys": ["Equal"],
          "displayLabel": "THR +"
        },
        {
          "id": "throttle-down",
          "kind": "button",
          "label": "X",
          "ariaLabel": "Throttle down",
          "face": "x",
          "zone": "right",
          "press": {
            "type": "increment",
            "field": "throttle",
            "delta": -0.12,
            "min": 0,
            "max": 1
          },
          "keys": ["Minus"],
          "displayLabel": "THR \u2212"
        },
        {
          "id": "restart",
          "kind": "button",
          "label": "START",
          "ariaLabel": "Restart flight from runway",
          "face": "start",
          "zone": "bottom",
          "press": {
            "type": "pulse",
            "values": {
              "pitch": 0,
              "roll": 0,
              "yaw": 0,
              "throttle": 0,
              "flaps": false,
              "gear": true,
              "restart": true,
              "brake": false,
              "level": false
            },
            "releaseValues": {
              "restart": false
            },
            "durationMs": 80
          },
          "displayLabel": "RESTART",
          "keys": ["KeyR"]
        },
        {
          "id": "wheel-brake",
          "kind": "button",
          "label": "L2",
          "displayLabel": "BRAKE",
          "ariaLabel": "Brake",
          "face": "l2",
          "zone": "top-left",
          "press": {
            "type": "patch",
            "values": {
              "brake": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "brake": false
            }
          },
          "keys": ["Space"]
        },
        {
          "id": "level-assist",
          "kind": "button",
          "label": "R2",
          "displayLabel": "LEVEL",
          "ariaLabel": "Level",
          "face": "r2",
          "zone": "top-right",
          "press": {
            "type": "patch",
            "values": {
              "level": true
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "level": false
            }
          },
          "keys": ["ShiftLeft", "ShiftRight"]
        }
      ],
      "initialState": {
        "pitch": 0,
        "roll": 0,
        "yaw": 0,
        "throttle": 0,
        "flaps": false,
        "gear": true,
        "restart": false,
        "brake": false,
        "level": false
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": true,
    "motion": false
  }
}
