{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "orbit-dodge",
    "version": "0.3.1",
    "title": "Orbit Dodge",
    "description": "Rotate around an orbital ring and evade incoming meteors as long as possible.",
    "minPlayers": 1,
    "maxPlayers": 4,
    "tickRate": 60,
    "snapshotRate": 20
  },
  "modes": ["shared-screen", "handheld"],
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "adaptive",
    "console": {
      "renderer": "builtin",
      "layout": "gamepad",
      "controls": [
        {
          "id": "rotate",
          "kind": "stick",
          "ariaLabel": "Rotate around orbit",
          "zone": "left",
          "action": {
            "type": "patch",
            "values": {
              "rotate": "$x"
            }
          },
          "release": {
            "type": "patch",
            "values": {
              "rotate": 0
            }
          },
          "keys": {
            "left": ["ArrowLeft", "KeyA"],
            "right": ["ArrowRight", "KeyD"]
          }
        }
      ],
      "initialState": {
        "rotate": 0
      }
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": true,
    "motion": false
  }
}
