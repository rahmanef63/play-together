{
  "schemaVersion": 1,
  "protocolVersion": 1,
  "game": {
    "id": "reaction-rush",
    "version": "0.3.0",
    "title": "Reaction Rush",
    "description": "A reflex duel where players must react to GO without false-starting.",
    "minPlayers": 1,
    "maxPlayers": 8,
    "tickRate": 30,
    "snapshotRate": 15
  },
  "modes": ["shared-screen", "handheld"],
  "controller": {
    "supportsRemote": true,
    "supportsHandheld": true,
    "preferredOrientation": "portrait",
    "console": {
      "renderer": "builtin",
      "layout": "arcade",
      "controls": [
        {
          "id": "hit",
          "kind": "button",
          "label": "A",
          "ariaLabel": "Reaction button",
          "face": "a",
          "zone": "right",
          "press": {
            "type": "send",
            "payload": {
              "action": "hit"
            }
          },
          "keys": ["Space", "Enter"]
        }
      ]
    }
  },
  "capabilities": {
    "touch": true,
    "keyboard": true,
    "gamepad": false,
    "motion": false
  }
}
